# -------------------------------------------------------------------
# VideoLyricsIA backend environment
# -------------------------------------------------------------------
# Copy to `.env` and fill in the real values. Never commit `.env`.

# Environment: dev | prod | production | test. In prod, JWT_SECRET y
# OPENAI_API_KEY deben estar setteados o el API se niega a bootear.
ENV=dev
ENVIRONMENT=dev

# -------------------------------------------------------------------
# OpenAI (Whisper transcription + lyric metadata)
# -------------------------------------------------------------------
# CRÍTICO en prod: el API rompe al boot si esta var no está seteada
# cuando ENV=prod o ENVIRONMENT=production (ver auth.py:95-98). Sin
# estar acá costaba debugging cuando faltaba.
OPENAI_API_KEY=

# -------------------------------------------------------------------
# Google Vertex AI (Veo 3 + Imagen 4 + Gemini)
# -------------------------------------------------------------------
GOOGLE_APPLICATION_CREDENTIALS=vertex_credentials.json
VERTEX_PROJECT=your-gcp-project-id
VERTEX_LOCATION=us-central1
# Gemini API key (fallback de Vertex). Solo Vertex → dejá vacío.
GEMINI_API_KEY=

# Genius.com API token (optional, lyrics fallback). When set, Genly
# tries Genius for tracks lrclib didn't return. Genius has way better
# coverage for UMG/Sony/Warner mainstream catalogue but ships text only
# — forced_align handles the timestamps from audio. Register a client at
# https://genius.com/api-clients to get a token; client-access only, no
# OAuth scopes required. Without this, Genly stays on lrclib-only
# behaviour (no regression).
GENIUS_API_TOKEN=

# -------------------------------------------------------------------
# YouTube OAuth (optional; only needed for /youtube/upload)
# -------------------------------------------------------------------
YOUTUBE_TOKEN_PATH=youtube_token.json
YOUTUBE_OAUTH_PATH=youtube_oauth.json

# -------------------------------------------------------------------
# Authentication
# -------------------------------------------------------------------
# Generate with: openssl rand -base64 32
JWT_SECRET=change-this-to-a-random-secret-key
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
ADMIN_PASSWORD=change-this-too

# -------------------------------------------------------------------
# Database (Postgres)
# -------------------------------------------------------------------
# Default: sqlite local. En prod debe ser Postgres.
DATABASE_URL=sqlite:///./lyricgen.db
# Pool tuning. 8 connections × N workers vs Postgres 100 max.
DB_POOL_SIZE=8
DB_MAX_OVERFLOW=8

# -------------------------------------------------------------------
# Job queue (Redis + RQ)
# -------------------------------------------------------------------
# Sin este, el API hace fallback a in-process threads (dev only).
REDIS_URL=redis://localhost:6379/0

# Worker tuning
JOB_TIMEOUT_SECONDS=2700              # 45 min (YouTube delivery)
JOB_TIMEOUT_UMG_SECONDS=5400          # 90 min para delivery_profile=umg/both
JOB_RESULT_TTL_SECONDS=86400          # 24 h
JOB_FAILURE_TTL_SECONDS=604800        # 7 d
PRORES_PREWARM_TIMEOUT_SECONDS=900    # 15 min para transcode lazy
WORKER_MAX_JOBS=                      # rotate workers cada N jobs (anti-leak)

# Pipeline retry on worker death (RQ Retry):
PIPELINE_RETRY_MAX=1                  # 1 retry tras worker SIGKILL
PIPELINE_RETRY_INTERVAL_S=30

# -------------------------------------------------------------------
# ProRes / broadcast delivery (UMG)
# -------------------------------------------------------------------
# Comma-separated lowercase tenant_ids autorizados a pedir delivery
# ProRes. Admin role bypassa este allowlist.
PRORES_TENANTS=umg
# Pre-warm ProRes ni bien termina el render MP4 (en lugar de lazy
# on first /download). Best-effort — si cola saturada, skipea.
PRORES_PREWARM=1
PRORES_PREWARM_MAX_QUEUE_DEPTH=15

# -------------------------------------------------------------------
# Cloud storage (Cloudflare R2)
# -------------------------------------------------------------------
# Sin esto, los deliverables quedan en disco local y /download
# streama por el API (lento para archivos grandes; OK para dev).
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET=videolyricsia-masters

# Direct-to-R2 upload tuning (presigned PUT)
MULTIPART_THRESHOLD_BYTES=16777216    # 16 MB → switch single → multipart
MULTIPART_PART_SIZE_BYTES=8388608     # 8 MB per part
PRESIGN_PUT_TTL_S=900                 # presigned URL TTL

# -------------------------------------------------------------------
# Observability
# -------------------------------------------------------------------
SENTRY_DSN=
SENTRY_RELEASE=                       # opcional; se setea en deploy (git SHA)
SENTRY_TRACES_RATE=0.05               # 5% traces sample; 0 desactiva tracing
LOG_LEVEL=INFO
HEALTH_STARTUP_GRACE_S=20             # /health returns "starting" durante cold boot

# -------------------------------------------------------------------
# CORS
# -------------------------------------------------------------------
# Comma-separated allowlist. Empty + ENV=prod = boot fail (main.py:171).
# Prod: setear explícito, ej:
#   CORS_ORIGINS=https://www.genly.pro,https://app.genly.pro,https://umg.genly.pro
CORS_ORIGINS=
# Opcional: regex alternativo. ⚠️ debe ser ANCLADO y con dots literales —
# `.*` o `.*vercel\.app` permite credentialed bypass desde cualquier
# subdominio que matchee.
CORS_ORIGIN_REGEX=

# -------------------------------------------------------------------
# Frontend / public URLs
# -------------------------------------------------------------------
# Usado en OAuth callbacks, magic links, password reset emails, y como
# fallback CORS si CORS_ORIGINS no está seteado.
FRONTEND_URL=https://app.genly.pro
APP_URL=https://app.genly.pro

# -------------------------------------------------------------------
# Billing (Stripe)
# -------------------------------------------------------------------
# CRÍTICO en prod. Sin estos, /api/billing/checkout devuelve 500 y los
# webhooks no se pueden firmar.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Stripe Price IDs por plan. Crear en Stripe Dashboard → Products.
STRIPE_PRICE_100=
STRIPE_PRICE_250=
STRIPE_PRICE_500=
STRIPE_PRICE_1000=

# -------------------------------------------------------------------
# Email (Resend) — emails transaccionales + alertas
# -------------------------------------------------------------------
RESEND_API_KEY=
RESEND_FROM=Genly <no-reply@genly.pro>
ALERT_EMAIL=alerts@genly.pro          # recibe outages de uptime/preflight

# -------------------------------------------------------------------
# Google Vertex AI credentials (Imagen / Gemini)
# -------------------------------------------------------------------
# En Railway hay 2 caminos: (a) montar vertex_credentials.json vía
# `Volumes` y apuntar GOOGLE_APPLICATION_CREDENTIALS, (b) setear el JSON
# entero base64-encoded en GOOGLE_APPLICATION_CREDENTIALS_JSON_B64 — el
# bootstrap en credentials_bootstrap.py lo decodifica a /tmp en cold start.
# Elegir UNO; tener ambos pisa con el b64.
GOOGLE_APPLICATION_CREDENTIALS_JSON_B64=

# -------------------------------------------------------------------
# Rate limiting
# -------------------------------------------------------------------
RATE_LIMIT_ENABLED=true

# -------------------------------------------------------------------
# Upload limits
# -------------------------------------------------------------------
MAX_UPLOAD_MB=50

# -------------------------------------------------------------------
# Google Drive OAuth (botón "Guardar en Drive")
# -------------------------------------------------------------------
# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0
# Client ID (Web Application). Authorized redirect URIs debe matchear
# GOOGLE_OAUTH_REDIRECT_URI. Scope que pide la app: `drive.file`
# (limitado a archivos creados por la app — no requiere Google app
# verification, podemos shippear sin esperar review).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Ejemplo prod: https://genly-ai.up.railway.app/drive/callback
# Ejemplo staging: https://api-staging-9b82.up.railway.app/drive/callback
GOOGLE_OAUTH_REDIRECT_URI=

# Fernet key para encriptar refresh_tokens de Drive en DB.
# Generala con:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Si rotás la key, todos los users tienen que reconectar Drive
# (los tokens viejos quedan ilegibles).
DRIVE_TOKEN_ENCRYPTION_KEY=

# Canary allowlist para la integración Drive. Lista de tenant_ids
# separados por coma (e.g. "umg,warner"). Vacío = SOLO admin tiene
# acceso. Mismo patrón que PRORES_TENANTS: cambia sin redeploy de
# código. Cuando UMG/Warner u otro tenant esté listo para probar,
# se agrega su tenant_id acá y ven el botón "Guardar en Drive".
DRIVE_ENABLED_TENANTS=

# -------------------------------------------------------------------
# Email (transactional via Brevo)
# -------------------------------------------------------------------
BREVO_API_KEY=
BREVO_SENDER_EMAIL=noreply@example.com
BREVO_SENDER_NAME=GenLy
# Staging: los emails se redirigen a este address en vez de enviarse
# al destinatario real. Defensa contra emails accidentales a clientes.
EMAIL_STAGING_REDIRECT=

# -------------------------------------------------------------------
# Lyrics reference (optional, improves /transcribe UX)
# -------------------------------------------------------------------
GENIUS_TOKEN=

# -------------------------------------------------------------------
# Whisper tuning
# -------------------------------------------------------------------
# 0 para deshabilitar el large-v3 fallback en transcripciones sparse.
WHISPER_FALLBACK_ENABLED=1

# -------------------------------------------------------------------
# Reaper / background sweeps
# -------------------------------------------------------------------
# Job se considera "orphan polling" si la última AI call tiene
# duration_ms NULL más vieja que este threshold. Más bajo = más
# agresivo recuperando jobs colgados por worker death.
REAPER_ORPHAN_POLL_THRESHOLD_MIN=10

# -------------------------------------------------------------------
# Feature flags (dormant / experimentales)
# -------------------------------------------------------------------
# Cuando true, el text layer se compone con ffmpeg overlay filters
# (rápido) en vez de moviepy CompositeVideoClip (lento). Off por
# default; activar solo cuando esté validado en staging.
USE_FFMPEG_TEXT_LAYER=false

# -------------------------------------------------------------------
# UMG Compliance
# -------------------------------------------------------------------
REQUIRE_REVIEW=true
SEND_ARTIST_TO_AI=true
VERTEX_ENTERPRISE_CONFIRMED=false

# -------------------------------------------------------------------
# Timing engines — "Rotor-grade" (el audio es la fuente de verdad).
# Todos default OFF + requieren REPLICATE_API_TOKEN. Degradan al
# comportamiento actual (whisper-1 + lrclib) si fallan o están off.
# -------------------------------------------------------------------
# REPLICATE_API_TOKEN=r8_...
# Verificación de lrclib synced SIEMPRE (no solo cuando hay offset de
# duración). Atajó el caso "Cosas Mías" (lrclib corrido ~35s, durations
# iguales → antes no se verificaba). Default ON; umbral de confianza 0.4.
LRCLIB_VERIFY_ALWAYS=1
LRCLIB_VERIFY_THRESHOLD=0.4
# Forced alignment (stable-ts/whisperX vía Replicate): alinea la letra
# conocida al audio a ±50ms. ~$0.007/canción, ~75s.
FORCED_ALIGNER_ENABLED=0
# DEMUCS_MODEL=cjwbw/demucs:<version>   # override del modelo pineado
# Separación de voz (demucs) antes de transcribir/alinear. El mayor lever
# en canciones difíciles. ~$0.02-0.05/canción.
VOCAL_SEP_ENABLED=0
# Variante interna de demucs. Default mdx_extra (la que midió el paper
# arXiv 2506.15514: WER 47%→28%). Alternativas: htdemucs (más rápido,
# calidad algo menor), htdemucs_ft, mdx_extra_q, mdx, mdx_q.
DEMUCS_VARIANT=mdx_extra
# WHISPERX_MODEL=victor-upmeet/whisperx:<version>
# whisperX para el camino sin-letra (word-level <100ms + VAD). ~$0.01-0.03.
WHISPERX_ENABLED=0
# Beat-snap (rhythm engine, estilo Rotor): librosa.beat_track detecta el
# grid del tempo y se snappean los starts al beat más cercano dentro de
# ±200ms. Hace que las líneas "caigan a la música", no solo a la voz.
# Sin costo (librosa local, ~3-5s por canción).
BEAT_SNAP_ENABLED=0
BEAT_SNAP_WINDOW_MS=200

# -------------------------------------------------------------------
# Railway-specific
# -------------------------------------------------------------------
# SIGTERM→SIGKILL grace period en segundos. Default Railway: 30s.
#
# ⚠️ CRÍTICO en el servicio Worker: debe ser 1200 (20 min) para que un
#    deploy mid-render no mate jobs largos (UMG ProRes puede correr
#    60-90 min). La canonical source es railway.toml:25-38 — este
#    valor NO se puede setear desde railway.toml, hay que hacerlo en
#    el Railway dashboard del servicio Worker:
#       Railway → Worker → Variables → RAILWAY_SHUTDOWN_TIMEOUT_SECONDS=1200
#
# El valor de abajo (180) era el viejo default y fue causa del outage
# 2026-05-15 cuando Worker mató jobs in-flight en cada redeploy.
# Mantengo el placeholder aquí solo como referencia para servicios que
# NO sean el Worker (API puede vivir con 180s porque solo sirve HTTP
# sin work-horses).
RAILWAY_SHUTDOWN_TIMEOUT_SECONDS=180
# Worker dashboard value: 1200  (verificar manualmente en cada deploy nuevo)

# -------------------------------------------------------------------
# Test environment (no setear en prod)
# -------------------------------------------------------------------
# Si está seteado, los tests con marker @pytest.mark.postgres corren
# contra este DSN. En CI ya está configurado al postgres service del
# workflow (.github/workflows/ci.yml).
# DATABASE_URL=postgresql://test:test@localhost:5432/lyricgen_test
