# -------------------------------------------------------------------
# VideoLyricsIA backend environment
# -------------------------------------------------------------------
# Copy to `.env` and fill in the real values. Never commit `.env`.

# Environment: dev | prod | production | test. In prod, JWT_SECRET y
# OPENAI_API_KEY deben estar setteados o el API se niega a bootear.
ENV=dev
ENVIRONMENT=dev

# -------------------------------------------------------------------
# OpenAI (Whisper transcription + lyric metadata)
# -------------------------------------------------------------------
# CRÍTICO en prod: el API rompe al boot si esta var no está seteada
# cuando ENV=prod o ENVIRONMENT=production (ver auth.py:95-98). Sin
# estar acá costaba debugging cuando faltaba.
OPENAI_API_KEY=

# -------------------------------------------------------------------
# Google Vertex AI (Veo 3 + Imagen 4 + Gemini)
# -------------------------------------------------------------------
GOOGLE_APPLICATION_CREDENTIALS=vertex_credentials.json
VERTEX_PROJECT=your-gcp-project-id
VERTEX_LOCATION=us-central1
# Gemini API key (fallback de Vertex). Solo Vertex → dejá vacío.
GEMINI_API_KEY=
# Techo pago por canción. 0 = apagado (default seguro). Activar primero en
# canary después de auditar provenance histórica; 10 es el valor inicial
# recomendado, no un default implícito.
VEO_MAX_CALLS_PER_SONG=0
# Comma-separated tenant canary. Empty = fail-safe off; * = all tenants.
VEO_BUDGET_TENANTS=
VEO_BUDGET_WINDOW_DAYS=30

# Genius.com API token (optional, lyrics fallback). When set, Genly
# tries Genius for tracks lrclib didn't return. Genius has way better
# coverage for UMG/Sony/Warner mainstream catalogue but ships text only
# — forced_align handles the timestamps from audio. Register a client at
# https://genius.com/api-clients to get a token; client-access only, no
# OAuth scopes required. Without this, Genly stays on lrclib-only
# behaviour (no regression).
GENIUS_API_TOKEN=

# -------------------------------------------------------------------
# YouTube OAuth (optional; only needed for /youtube/upload)
# -------------------------------------------------------------------
YOUTUBE_TOKEN_PATH=youtube_token.json
YOUTUBE_OAUTH_PATH=youtube_oauth.json

# -------------------------------------------------------------------
# Authentication
# -------------------------------------------------------------------
# Generate with: openssl rand -base64 32
JWT_SECRET=change-this-to-a-random-secret-key
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
ADMIN_PASSWORD=change-this-too

# -------------------------------------------------------------------
# Database (Postgres)
# -------------------------------------------------------------------
# Default: sqlite local. En prod debe ser Postgres.
DATABASE_URL=sqlite:///./lyricgen.db
# Pool tuning. 8 connections × N workers vs Postgres 100 max.
DB_POOL_SIZE=8
DB_MAX_OVERFLOW=8

# -------------------------------------------------------------------
# Job queue (Redis + RQ)
# -------------------------------------------------------------------
# Sin este, el API hace fallback a in-process threads (dev only).
REDIS_URL=redis://localhost:6379/0

# Worker tuning
JOB_TIMEOUT_SECONDS=2700              # 45 min (YouTube delivery)
JOB_TIMEOUT_UMG_SECONDS=5400          # 90 min para delivery_profile=umg/both
JOB_RESULT_TTL_SECONDS=86400          # 24 h
JOB_FAILURE_TTL_SECONDS=604800        # 7 d
PRORES_PREWARM_TIMEOUT_SECONDS=900    # 15 min para transcode lazy
WORKER_MAX_JOBS=                      # rotate workers cada N jobs (anti-leak)

# Pipeline retry on worker death (RQ Retry):
PIPELINE_RETRY_MAX=1                  # 1 retry tras worker SIGKILL
PIPELINE_RETRY_INTERVAL_S=30

# -------------------------------------------------------------------
# ProRes / broadcast delivery (UMG)
# -------------------------------------------------------------------
# Comma-separated lowercase tenant_ids autorizados a pedir delivery
# ProRes. Admin role bypassa este allowlist.
PRORES_TENANTS=umg
# Pre-warm ProRes ni bien termina el render MP4 (en lugar de lazy
# on first /download). Best-effort — si cola saturada, skipea.
PRORES_PREWARM=1
PRORES_PREWARM_MAX_QUEUE_DEPTH=15

# -------------------------------------------------------------------
# Cloud storage (Cloudflare R2)
# -------------------------------------------------------------------
# Sin esto, los deliverables quedan en disco local y /download
# streama por el API (lento para archivos grandes; OK para dev).
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET=videolyricsia-masters

# Direct-to-R2 upload tuning (presigned PUT)
MULTIPART_THRESHOLD_BYTES=16777216    # 16 MB → switch single → multipart
MULTIPART_PART_SIZE_BYTES=8388608     # 8 MB per part
PRESIGN_PUT_TTL_S=900                 # presigned URL TTL

# -------------------------------------------------------------------
# Observability
# -------------------------------------------------------------------
SENTRY_DSN=
LOG_LEVEL=INFO
HEALTH_STARTUP_GRACE_S=20             # /health returns "starting" durante cold boot

# -------------------------------------------------------------------
# CORS
# -------------------------------------------------------------------
# Comma-separated allowlist. Empty = allow all (dev).
CORS_ORIGINS=

# -------------------------------------------------------------------
# Rate limiting
# -------------------------------------------------------------------
RATE_LIMIT_ENABLED=true

# -------------------------------------------------------------------
# Upload limits
# -------------------------------------------------------------------
MAX_UPLOAD_MB=50

# -------------------------------------------------------------------
# Google Drive OAuth (botón "Guardar en Drive")
# -------------------------------------------------------------------
# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0
# Client ID (Web Application). Authorized redirect URIs debe matchear
# GOOGLE_OAUTH_REDIRECT_URI. Scope que pide la app: `drive.file`
# (limitado a archivos creados por la app — no requiere Google app
# verification, podemos shippear sin esperar review).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Ejemplo prod: https://genly-ai.up.railway.app/drive/callback
# Ejemplo staging: https://api-staging-9b82.up.railway.app/drive/callback
GOOGLE_OAUTH_REDIRECT_URI=

# Fernet key para encriptar refresh_tokens de Drive en DB.
# Generala con:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Si rotás la key, todos los users tienen que reconectar Drive
# (los tokens viejos quedan ilegibles).
DRIVE_TOKEN_ENCRYPTION_KEY=

# Canary allowlist para la integración Drive. Lista de tenant_ids
# separados por coma (e.g. "umg,warner"). Vacío = SOLO admin tiene
# acceso. Mismo patrón que PRORES_TENANTS: cambia sin redeploy de
# código. Cuando UMG/Warner u otro tenant esté listo para probar,
# se agrega su tenant_id acá y ven el botón "Guardar en Drive".
DRIVE_ENABLED_TENANTS=

# -------------------------------------------------------------------
# Email (transactional via SMTP — prod uses Resend's SMTP gateway)
# -------------------------------------------------------------------
# emails.py is pure SMTP (no Brevo SDK). In prod we send through Resend:
#   SMTP_HOST=smtp.resend.com  SMTP_USER=resend  SMTP_PASSWORD=<resend API key>
# The From MUST be on the DKIM-authenticated domain genly.pro (NOT genly.ai —
# the code default in emails.py:18 is genly.ai and is wrong if left unset).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=GenLy AI <noreply@genly.pro>
SMTP_USE_TLS=true
# Staging safety: on non-prod, every outbound email is redirected to this
# single inbox (defensa contra emails accidentales a clientes). If empty on
# non-prod, mail is DROPPED. EMAIL_STAGING_ALLOWLIST (comma-separated) lets
# specific real addresses through unchanged. Prod ignores both. (emails.py:28-54)
EMAIL_STAGING_REDIRECT=
EMAIL_STAGING_ALLOWLIST=

# -------------------------------------------------------------------
# Stripe billing (Fase 2) — optional; unset = billing disabled (endpoints 503)
# -------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Checkout success/cancel redirects + email button links (also read by emails.py).
FRONTEND_URL=http://localhost:5173
# Recurring price ids — printed by `python setup_stripe.py`. Hydrate auth.py PLANS.
# (free + unlimited have NO Stripe price → no env var here.)
STRIPE_PRICE_100=
STRIPE_PRICE_250=
STRIPE_PRICE_500=
STRIPE_PRICE_1000=
# Customer Portal configuration. Pin in prod (printed by setup_stripe.py) so the
# app never does a runtime Configuration.create; if unset, the app lazily
# creates+caches one on first /billing/portal call.
STRIPE_PORTAL_CONFIG_ID=
# Footer links shown inside the hosted portal (default: FRONTEND_URL/privacy|/terms)
BILLING_PRIVACY_URL=
BILLING_TERMS_URL=

# -------------------------------------------------------------------
# Lyrics reference (optional, improves /transcribe UX)
# -------------------------------------------------------------------
GENIUS_TOKEN=

# -------------------------------------------------------------------
# Whisper tuning
# -------------------------------------------------------------------
# 0 para deshabilitar el large-v3 fallback en transcripciones sparse.
WHISPER_FALLBACK_ENABLED=1

# -------------------------------------------------------------------
# Reaper / background sweeps
# -------------------------------------------------------------------
# Job se considera "orphan polling" si la última AI call tiene
# duration_ms NULL más vieja que este threshold. Más bajo = más
# agresivo recuperando jobs colgados por worker death.
REAPER_ORPHAN_POLL_THRESHOLD_MIN=10

# -------------------------------------------------------------------
# Feature flags (dormant / experimentales)
# -------------------------------------------------------------------
# Cuando true, el text layer se compone con ffmpeg overlay filters
# (rápido) en vez de moviepy CompositeVideoClip (lento). Off por
# default; activar solo cuando esté validado en staging.
USE_FFMPEG_TEXT_LAYER=false

# -------------------------------------------------------------------
# UMG Compliance
# -------------------------------------------------------------------
REQUIRE_REVIEW=true
SEND_ARTIST_TO_AI=true
VERTEX_ENTERPRISE_CONFIRMED=false

# -------------------------------------------------------------------
# Timing engines — "Rotor-grade" (el audio es la fuente de verdad).
# Todos default OFF + requieren REPLICATE_API_TOKEN. Degradan al
# comportamiento actual (whisper-1 + lrclib) si fallan o están off.
# -------------------------------------------------------------------
# REPLICATE_API_TOKEN=r8_...
# Verificación de lrclib synced SIEMPRE (no solo cuando hay offset de
# duración). Atajó el caso "Cosas Mías" (lrclib corrido ~35s, durations
# iguales → antes no se verificaba). Default ON; umbral de confianza 0.4.
LRCLIB_VERIFY_ALWAYS=1
LRCLIB_VERIFY_THRESHOLD=0.4
# Forced alignment (stable-ts/whisperX vía Replicate): alinea la letra
# conocida al audio a ±50ms. ~$0.007/canción, ~75s.
FORCED_ALIGNER_ENABLED=0
# DEMUCS_MODEL=cjwbw/demucs:<version>   # override del modelo pineado
# Separación de voz (demucs) antes de transcribir/alinear. El mayor lever
# en canciones difíciles. ~$0.02-0.05/canción.
VOCAL_SEP_ENABLED=0
# Variante interna de demucs. Default mdx_extra (la que midió el paper
# arXiv 2506.15514: WER 47%→28%). Alternativas: htdemucs (más rápido,
# calidad algo menor), htdemucs_ft, mdx_extra_q, mdx, mdx_q.
DEMUCS_VARIANT=mdx_extra
# Offline research candidates. These flags are not imported by pipeline.py and
# must remain OFF in API/worker services. Model downloads require a second,
# explicit opt-in so a benchmark cannot silently pull multi-GB checkpoints.
RESEARCH_QWEN3_ASR_ENABLED=0
RESEARCH_QWEN3_ALIGNER_ENABLED=0
RESEARCH_ROFORMER_ENABLED=0
RESEARCH_ALLOW_MODEL_DOWNLOADS=0
RESEARCH_QWEN3_ASR_MODEL=Qwen/Qwen3-ASR-1.7B
RESEARCH_QWEN3_ALIGNER_MODEL=Qwen/Qwen3-ForcedAligner-0.6B
RESEARCH_QWEN_DEVICE=cuda:0
RESEARCH_QWEN_DTYPE=bfloat16
RESEARCH_QWEN_BATCH_SIZE=8
# WHISPERX_MODEL=victor-upmeet/whisperx:<version>
# whisperX para el camino sin-letra (word-level <100ms + VAD). ~$0.01-0.03.
WHISPERX_ENABLED=0
# Política de prompt para la primera pasada de whisper-1:
#   off   = audio-first (default; referencia solo para alineación posterior)
#   short = primeros 120 chars (experimento / rollback)
#   full  = referencia, cap interno 800 chars (legacy; alto riesgo de loops)
WHISPER_REFERENCE_PROMPT_MODE=off
# Reagrupar los word timestamps de Whisper según las líneas humanas de
# LRCLIB/Gemini. Default ON; se conserva como kill-switch operativo.
LRCLIB_PLAIN_ALIGNER_ENABLED=1
# Beat-snap (rhythm engine, estilo Rotor): librosa.beat_track detecta el
# grid del tempo y se snappean los starts al beat más cercano dentro de
# ±200ms. Hace que las líneas "caigan a la música", no solo a la voz.
# Sin costo (librosa local, ~3-5s por canción).
BEAT_SNAP_ENABLED=0
BEAT_SNAP_WINDOW_MS=200

# Quality gate final de transcripción:
#   observe = calcula/persiste el veredicto sin bloquear (rollout seguro)
#   enforce = exige revisión explícita antes de /generate si hay evidencia crítica
TRANSCRIPTION_QUALITY_MODE=observe
# v5 containment: expensive retries run only on the isolated quality queue.
# Keep inline off so transcription/bg_preview latency cannot be starved.
TRANSCRIPTION_QUALITY_INLINE_RETRY=0
# Enable on API/ShortWorker only after the isolated Railway service exists.
TRANSCRIPTION_QUALITY_QUEUE_ENABLED=0
# Human-correction learning is independently kill-switchable. Capture and
# mining require the isolated queue above; both remain off during migration.
QUALITY_LEARNING_CAPTURE_ENABLED=0
QUALITY_LEARNING_MINING_ENABLED=0
QUALITY_LEARNING_MODEL_SHADOW_ENABLED=0
QUALITY_LEARNING_ABLATIONS_ENABLED=0
QUALITY_LEARNING_PROPOSALS_ENABLED=0
QUALITY_LEARNING_JOB_TIMEOUT=600
QUALITY_LEARNING_MINING_TIMEOUT=900
QUALITY_LEARNING_VALIDATION_TIMEOUT=3600
# Secret-store only: pseudonymises lexical/operator/session identifiers.
QUALITY_LEARNING_HMAC_KEY=
# Required generation identifier. Rotate it together with the HMAC key; miners
# never mix identities produced by different generations.
QUALITY_LEARNING_HMAC_KEY_ID=
# Signed no-render benchmark consumed by an explicitly requested validation.
QUALITY_LEARNING_BENCHMARK_REPORT_PATH=
# Human proposal receipts. Private material belongs only in the API secret store.
QUALITY_LEARNING_SIGNING_PRIVATE_KEY=
QUALITY_LEARNING_SIGNING_KEY_ID=
# Offline model training and runtime shadow verification use separate keys.
QUALITY_LEARNING_SPLIT_KEY=
QUALITY_LEARNING_MODEL_PRIVATE_KEY=
QUALITY_LEARNING_MODEL_KEY_ID=
QUALITY_LEARNING_MODEL_PATH=
QUALITY_LEARNING_MODEL_PUBLIC_KEYS={}
# Startup fails closed unless Railway's per-replica limits are at or below these.
QUALITY_WORKER_MAX_CPUS=2
QUALITY_WORKER_MAX_MEMORY_BYTES=4294967296
# Stable rollout: named tenants bypass the percentage. Keep 0 until the
# isolated worker is healthy, then use pilot -> 5 -> 25 -> 100.
TRANSCRIPTION_QUALITY_PILOT_TENANTS=
TRANSCRIPTION_QUALITY_ROLLOUT_PERCENT=0
# Enforcement has an independent stable cohort; MODE=enforce alone never
# blocks the whole fleet. Named tenants bypass the percentage.
TRANSCRIPTION_QUALITY_ENFORCE_PILOT_TENANTS=
TRANSCRIPTION_QUALITY_ENFORCE_PERCENT=0
# Set to 1 only after the frozen benchmark + shadow acceptance gates pass.
TRANSCRIPTION_QUALITY_CALIBRATED=0
# Immutable calibration identity. All three must match the running v6 release
# and config fingerprint or the gate fails closed to review_required.
TRANSCRIPTION_QUALITY_CALIBRATION_ID=
TRANSCRIPTION_QUALITY_CALIBRATION_POLICY=lyrics-quality-v6
TRANSCRIPTION_QUALITY_CALIBRATION_CONFIG_FINGERPRINT=
TRANSCRIPTION_QUALITY_RELEASE_REPORT_PATH=
TRANSCRIPTION_QUALITY_RELEASE_REPORT_SHA256=
TRANSCRIPTION_QUALITY_BENCHMARK_MANIFEST_PATH=
BENCHMARK_RELEASE_PUBLIC_KEYS={}
BENCHMARK_RELEASE_PRIVATE_KEY=
BENCHMARK_RELEASE_KEY_ID=
# Legacy structural autorepair is suggestion-only under policy v6. The removed
# TARGETED_STRUCTURAL_AUTOREPAIR_ENABLED boolean cannot authorize writes.
TARGETED_STRUCTURAL_AUTOREPAIR_MODE=observe
# Acoustic structure + suggestion-only monotonic mapping for unsafe windows.
# The legacy TARGETED_ACOUSTIC_CTC_ENABLED alias remains accepted during rollout.
TARGETED_ACOUSTIC_STRUCTURE_ENABLED=0
# Trusted internal Spanish XLSR-CTC contrastive verifier. Evidence requires an
# immutable model revision and a frozen calibration artifact matching its hash.
CTC_ALIGN_MODEL_REVISION=96d7e9b4e4a78af515a3c6d3cee7c0826045d276
QUALITY_CTC_CALIBRATION_PATH=
QUALITY_CTC_CALIBRATION_SHA256=
# Secret-store only. Used by the trusted exporter/gate to attest every shadow
# decision row; never put the real key in source control or benchmark files.
BENCHMARK_SHADOW_PUBLIC_KEYS={}
BENCHMARK_SHADOW_PRIVATE_KEY=
BENCHMARK_SHADOW_KEY_ID=
# Ed25519 trust roots. Values are JSON maps: {"key-id":"base64-raw-public-key"}.
# Private signing keys live only in the corresponding annotation/review,
# operator-evidence or FinOps service, never in the API/web environment.
BENCHMARK_ANNOTATION_PUBLIC_KEYS={}
BENCHMARK_REVIEW_PUBLIC_KEYS={}
BENCHMARK_OPERATOR_EVIDENCE_PUBLIC_KEYS={}
BENCHMARK_FINOPS_PUBLIC_KEYS={}
# Trusted exporter-only secrets (base64 raw Ed25519 private keys).
BENCHMARK_OPERATOR_EVIDENCE_PRIVATE_KEY=
BENCHMARK_OPERATOR_EVIDENCE_KEY_ID=
BENCHMARK_FINOPS_PRIVATE_KEY=
BENCHMARK_FINOPS_KEY_ID=
# Offline phone/event training and CPU export trust roots. Training and export
# remain uncalibrated artifacts; these keys never grant runtime authorization.
QUALITY_V6_TRAINING_PUBLIC_KEYS={}
QUALITY_V6_TRAINING_PRIVATE_KEY=
QUALITY_V6_TRAINING_KEY_ID=
QUALITY_V6_EXPORT_PRIVATE_KEY=
QUALITY_V6_EXPORT_KEY_ID=
# Re-transcribe únicamente las ventanas inseguras con whisper-1 sobre stem
# y mezcla. Acepta cambios sólo cuando dos fuentes coinciden.
TARGETED_CONSENSUS_ENABLED=0
# Shows independently corroborated candidates as non-applicable observations
# so normal review work can accumulate a signed calibration dataset.
QUALITY_CONSENSUS_OBSERVATIONS_ENABLED=0
# Human-click only suggestions. This never grants automatic mutation.
QUALITY_OPERATOR_SUGGESTIONS_ENABLED=0
QUALITY_T4_STRUCTURAL_OBSERVE_ENABLED=0
TARGETED_GEMINI_VERIFY_ENABLED=0
TARGETED_CONSENSUS_MAX_WINDOWS=3
TARGETED_CONSENSUS_MAX_BILLED_SECONDS=120
# Versioned pricing is supplied operationally; zero means cost is unknown,
# never free. Submitted seconds are charged conservatively even on timeout.
QUALITY_ASR_USD_PER_MINUTE=0
QUALITY_OPENAI_ASR_USD_PER_MINUTE=0
QUALITY_GEMINI_AUDIO_USD_PER_MINUTE=0
TARGETED_CONSENSUS_MAX_CLIP_SECONDS=40
TARGETED_CONSENSUS_DEADLINE_SECONDS=120
TRANSCRIPTION_QUALITY_JOB_TIMEOUT=1200
# Bounded CPU work per isolated job. Remaining windows stay explicitly unsafe.
TRANSCRIPTION_QUALITY_MAX_WINDOWS=4
EXPECTED_QUALITY_WORKER_REPLICAS=1
# Content-addressed intermediate retention and safety caps.
QUALITY_CACHE_FEATURES_TTL_SECONDS=604800
QUALITY_CACHE_BOUNDARIES_TTL_SECONDS=604800
QUALITY_CACHE_CTC_TTL_SECONDS=259200
QUALITY_CACHE_N_BEST_TTL_SECONDS=172800
# Dedicated Redis only. Never point this at REDIS_URL used by RQ.
QUALITY_CACHE_REDIS_URL=
QUALITY_CACHE_MAX_VALUE_BYTES=67108864
QUALITY_CACHE_MAX_STORED_BYTES=8388608
DEMUCS_MODEL_VERSION=
DEMUCS_MODEL_CHECKSUM=
# Workers poll this long for the API's expand migration before starting RQ.
WORKER_SCHEMA_WAIT_TIMEOUT_SECONDS=600

# -------------------------------------------------------------------
# Railway-specific
# -------------------------------------------------------------------
# SIGTERM→SIGKILL grace period en segundos. Default Railway: 30s,
# pero RQ workers necesitan ≥180s para drain in-flight Veo poll
# (60-120s típicos).
RAILWAY_SHUTDOWN_TIMEOUT_SECONDS=180

# -------------------------------------------------------------------
# Test environment (no setear en prod)
# -------------------------------------------------------------------
# Si está seteado, los tests con marker @pytest.mark.postgres corren
# contra este DSN. En CI ya está configurado al postgres service del
# workflow (.github/workflows/ci.yml).
# DATABASE_URL=postgresql://test:test@localhost:5432/lyricgen_test
# Experimental only: attach an immutable Repair Agent candidate diff to the
# final transcription. It never changes job segments; promote per repair type
# only after benchmark calibration.
REFERENCE_ATTESTATION_MODE=off
DELIVERY_REPAIR_SHADOW_MODE=off

# Final rendered-video preflight. `observe` records/issues suggestions but can
# never block approval; `enforce` blocks fresh FAIL and unacknowledged WARN.
DELIVERY_QC_MODE=off
DELIVERY_QC_OCR_ENABLED=0
DELIVERY_QC_OCR_MODEL=gemini-2.5-flash
DELIVERY_QC_OCR_MAX_FRAMES=24
DELIVERY_QC_TIMEOUT_SECONDS=90
DELIVERY_QC_MEDIA_SCAN_ENABLED=1
