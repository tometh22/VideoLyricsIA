{
  "name": "lyricgen-frontend",
  "private": true,
  "version": "1.1.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "check:i18n": "node scripts/check-i18n-keys.mjs",
    "check:fetch": "node scripts/check-fetch-error-handling.mjs",
    "check": "npm run check:i18n && npm run check:fetch",
    "build": "npm run check:i18n && VITE_RELEASE=${VITE_RELEASE:-$VERCEL_GIT_COMMIT_SHA} vite build",
    "analyze": "npm run check:i18n && ANALYZE=1 vite build && echo '\nOpen dist/stats.html in your browser.'",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:install": "playwright install chromium"
  },
  "dependencies": {
    "@sentry/react": "^10.55.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-joyride": "^3.1.0",
    "react-router-dom": "^7.18.2",
    "recharts": "^3.8.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.26",
    "rollup-plugin-visualizer": "^7.0.1",
    "tailwindcss": "^3.4.17",
    "vite": "^6.4.3",
    "vitest": "^4.1.6"
  }
}
