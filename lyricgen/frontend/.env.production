# Production build env. Vite loads this AFTER `.env.local` in `vite build`
# mode and it WINS — so even if a developer's `.env.local` points to
# staging (which it does in this checkout: VITE_API_URL=api-staging-...),
# `npm run build` ships with the prod API URL below.
#
# Audit 2026-05-26 incident: an existing `dist/` had been built with the
# staging `.env.local` URL and would have routed app.genly.pro → staging
# on the next deploy. This file is the guard against that recurring.
#
# Vite precedence in build mode (later wins):
#   .env  <  .env.local  <  .env.production  <  .env.production.local
VITE_API_URL=https://api.genly.pro
