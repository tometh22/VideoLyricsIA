# Redis snapshots — created when running redis-server locally for the
# stress / load tests; runtime artifact, not source.
dump.rdb
*.rdb
# Golden-set audio, model caches, and generated evaluation outputs are local.
eval/golden/
eval/runs/
eval/cache/
eval/hypotheses/
eval/*.partial/
# Human-review exports may contain approved client lyrics. Keep them local;
# their generators and aggregate reports remain versioned.
eval/reports/**/word_errors_*.csv
eval/reports/**/timing_corrections_*.csv
eval/reports/**/error_taxonomy_validation_*.csv
.pytest_cache/
**/__pycache__/
